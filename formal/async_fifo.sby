# =============================================================================
# SymbiYosys Formal Verification Configuration — async_fifo
# Tasks:
#   - bmc   : Bounded Model Checking (depth 40) across unconstrained dual clocks
#   - prove : Unbounded k-Induction proof (zero overflow/underflow/data loss)
#   - cover : Reachability witness traces (full, almost-full/empty, wrap, 2-val)
# Usage:
#   sby -f formal/async_fifo.sby
# =============================================================================

[tasks]
bmc
prove
cover

[options]
multiclock on
bmc:   mode bmc
bmc:   depth 40
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 40

[engines]
smtbmc z3

[script]
read -formal -sv cdc_sync_2ff.sv cdc_reset_sync.sv fifo_mem_dp.sv async_fifo.sv
chparam -set DATA_WIDTH 8 -set ADDR_WIDTH 3 -set SYNC_STAGES 2 -set ALMOST_FULL_THRESH 2 -set ALMOST_EMPTY_THRESH 2 -set USE_RESET_SYNC 0 async_fifo
prep -top async_fifo

[files]
../rtl/cdc_sync_2ff.sv
../rtl/cdc_reset_sync.sv
../rtl/fifo_mem_dp.sv
../rtl/async_fifo.sv
